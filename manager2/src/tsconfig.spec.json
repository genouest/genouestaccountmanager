{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "types": [
      "jasmine",
      "node"
    ]
  },
  "files": [
    "test.ts",
    "polyfills.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  // Enable again if templates are improved someday to follow the criteria of
  // strictTemplates parameter
  "angularCompilerOptions": {
    // "extendedDiagnostics": {
    //   "checks": {
    //     "nullishCoalescingNotNullable": "suppress",
    //     "optionalChainNotNullable": "suppress"
    //   }
    // },
    "strictTemplates": false
  }
}
